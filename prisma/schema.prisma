// Lidd School CRM — схема базы данных (черновик для этапа 1).
// Деньги — целые рубли (Int). Часы — Decimal(5,2). Даты — UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Справочники и enum ───────────────────────────

enum Role {
  OWNER
  ADMIN
  TEACHER
}

enum Program {
  EXAM // ОГЭ / ЕГЭ
  SCHOOL // школьная программа
}

enum PaymentMode {
  MONTHLY // абонемент на месяц
  PER_LESSON // поурочно, за 24 ч до урока
}

enum TariffKind {
  INDIVIDUAL
  GROUP
}

enum Gender {
  MALE
  FEMALE
}

enum ClientStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum LessonFormat {
  OFFLINE
  ONLINE
}

enum LessonStatus {
  PLANNED
  DONE
  CANCELLED // отменён (кем — в cancelledBy)
  MOVED // перенесён (создаётся новый урок, movedToId)
}

enum CancelledBy {
  SCHOOL
  CLIENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT_EXCUSED // уважительный (предупредили за 24 ч)
  ABSENT_UNEXCUSED // неуважительный
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PAID
  PARTIALLY_PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  SBP
  ONLINE
}

enum LedgerType {
  PAYMENT // + поступление
  LESSON_CHARGE // − списание за проведённый урок (поурочная оплата)
  INVOICE_CHARGE // − начисление по счёту абонемента
  CREDIT_TRANSFER // + перенос стоимости на следующий месяц
  REFUND // − возврат денег
  ADJUSTMENT // ± ручная корректировка (обязателен комментарий)
}

enum RateType {
  PER_HOUR // ₽ за урок-час
  PERCENT // % от стоимости урока для клиента
  PER_LESSON // фикс за урок
}

enum BonusApply {
  WHOLE_MONTH // процент ко всей зарплате месяца
  ABOVE_THRESHOLD // только к часам сверх порога (прогрессивно)
}

enum PayrollStatus {
  OPEN // месяц идёт
  CLOSED // месяц закрыт, сумма зафиксирована
  PAID
}

enum TaskStatus {
  NEW
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

enum LeadStage {
  NEW
  CONTACTED
  TRIAL_SCHEDULED
  TRIAL_DONE
  WON
  LOST
}

enum LeadSource {
  SITE
  AVITO
  VK
  REFERRAL // сарафанное радио
  OTHER
}

enum MessageStatus {
  QUEUED // ждёт отправки
  SENT
  FAILED
  SKIPPED // не отправлено: у родителя нет Telegram или бот не настроен
}

enum Channel {
  TELEGRAM
  WHATSAPP
  SMS
}

// ─────────────────────────── Пользователи и педагоги ───────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  teacher         Teacher?
  assignedTasks   Task[]              @relation("TaskAssignee")
  createdTasks    Task[]              @relation("TaskCreator")
  ownedLeads      Lead[]
  leadTouches     LeadTouch[]
  ledgerEntries   LedgerEntry[]
  payments        Payment[]
  auditLogs       AuditLog[]
  expenses        Expense[]           @relation("ExpenseAuthor")
  payrollAdjusts  PayrollAdjustment[] @relation("PayrollAdjustmentAuthor")
  payrollPayments PayrollPayment[]    @relation("PayrollPaymentAuthor")
  lessonsMarked   Lesson[]            @relation("LessonMarkedBy")
  lessonsCreated  Lesson[]            @relation("LessonCreatedBy")
  seriesCreated   ScheduleSeries[]    @relation("SeriesCreatedBy")
  payrollsClosed  Payroll[]           @relation("PayrollClosedBy")
  invites         UserInvite[]        @relation("UserInvites")
  taskComments    TaskComment[]       @relation("TaskCommentAuthor")
}

model Teacher {
  id        String   @id @default(cuid())
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id])
  fullName  String
  phone     String?
  color     String // hex для расписания
  onlineUrl String? // постоянная ссылка на онлайн-занятие, подставляется в новые уроки
  subjects  String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  ratePlans TeacherRatePlan[]
  series    ScheduleSeries[]
  lessons   Lesson[]
  groups    Group[]
  accruals  TeacherAccrual[]
  payrolls  Payroll[]
}

// ─────────────────────────── Ставки педагогов ───────────────────────────

model RatePlan {
  id              String     @id @default(cuid())
  name            String // «Стандартный шаблон школы»
  isDefault       Boolean    @default(false)
  type            RateType   @default(PER_HOUR)
  baseAmount      Int        @default(700) // ₽ за урок-час / за урок
  percent         Decimal?   @db.Decimal(5, 2) // для type = PERCENT
  groupPerStudent Int        @default(100) // доплата за каждого присутствующего в группе
  trialFixed      Int        @default(500) // оплата пробного урока
  payForUnexcused Boolean    @default(false)
  bonusApply      BonusApply @default(WHOLE_MONTH)
  // Версии: изменение шаблона создаёт новую запись с тем же familyId, действующую с 1-го числа месяца.
  familyId        String? // id первой версии шаблона
  versionFrom     DateTime?  @db.Date // с какого месяца действует эта версия
  isArchived      Boolean    @default(false) // старая версия — только для истории
  createdAt       DateTime   @default(now())

  tiers    RateTier[]
  teachers TeacherRatePlan[]
}

model RateTier {
  id             String   @id @default(cuid())
  planId         String
  plan           RatePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  thresholdHours Decimal  @db.Decimal(5, 2) // 30, 45
  bonusPercent   Decimal  @db.Decimal(5, 2) // 10, 15

  @@unique([planId, thresholdHours])
}

// История назначений ставки педагогу
model TeacherRatePlan {
  id        String   @id @default(cuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  planId    String
  plan      RatePlan @relation(fields: [planId], references: [id])
  validFrom DateTime @db.Date // всегда 1-е число месяца: ставка меняется только с начала месяца
  createdAt DateTime @default(now())

  @@unique([teacherId, validFrom])
}

// ─────────────────────────── Клиенты ───────────────────────────

model Client {
  id          String       @id @default(cuid())
  fullName    String // «Фамилия Имя»
  gender      Gender? // для склонения имени в сообщениях
  fullNameGen String? // ручная правка родительного падежа («у Миши Иванова»), иначе — автоматически
  grade       Int? // класс
  school      String?
  phone       String?
  status      ClientStatus @default(ACTIVE)
  program     Program
  paymentMode PaymentMode
  // Свой тариф ученика для индивидуальных уроков; пусто — тариф школы
  tariffId    String?
  tariff      Tariff?      @relation(fields: [tariffId], references: [id])
  goal        String?
  source      LeadSource?
  notes       String?
  createdAt   DateTime     @default(now())

  parents       Parent[]
  groupMembers  GroupMember[]
  series        ScheduleSeries[]
  lessons       Lesson[]
  attendances   Attendance[]
  invoices      MonthlyInvoice[]
  payments      Payment[]
  ledgerEntries LedgerEntry[]
  tasks         Task[]
  convertedFrom Lead?
  messages      Message[]
  paymentLinks  PaymentLink[]
}

model Parent {
  id               String    @id @default(cuid())
  clientId         String
  client           Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fullName         String
  relation         String? // мама, папа…
  phone            String
  telegramChatId   String?
  telegramLinkedAt DateTime?
  preferredChannel Channel   @default(TELEGRAM)
  isPrimary        Boolean   @default(true)

  invites  TelegramInvite[]
  messages Message[]
}

// ─────────────────────────── Тарифы ───────────────────────────

// Тариф: именованная цена за урок-час для сочетания формат × программа × способ оплаты.
// Тариф школы (isDefault) — у каждого сочетания ровно один, его получают ученики без своего тарифа.
// Цена меняется новой записью TariffPrice с датой начала — прошлые уроки и счета не пересчитываются.
model Tariff {
  id          String      @id @default(cuid())
  name        String
  kind        TariffKind  @default(INDIVIDUAL)
  program     Program
  paymentMode PaymentMode
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now())

  prices  TariffPrice[]
  clients Client[]

  @@index([kind, program, paymentMode])
}

model TariffPrice {
  id           String   @id @default(cuid())
  tariffId     String
  tariff       Tariff   @relation(fields: [tariffId], references: [id], onDelete: Cascade)
  pricePerHour Int
  validFrom    DateTime @db.Date
  createdAt    DateTime @default(now())
  createdById  String?

  @@unique([tariffId, validFrom])
}

// ─────────────────────────── Расписание ───────────────────────────

model Room {
  id      String           @id @default(cuid())
  name    String           @unique // «Каб. 1»
  series  ScheduleSeries[]
  lessons Lesson[]
}

model Group {
  id          String  @id @default(cuid())
  name        String // «ОГЭ-9А»
  subject     String
  program     Program
  teacherId   String
  teacher     Teacher @relation(fields: [teacherId], references: [id])
  maxStudents Int     @default(8)
  isActive    Boolean @default(true)

  members GroupMember[]
  series  ScheduleSeries[]
  lessons Lesson[]
}

model GroupMember {
  id       String    @id @default(cuid())
  groupId  String
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  clientId String
  client   Client    @relation(fields: [clientId], references: [id])
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@unique([groupId, clientId])
}

// Регулярное занятие: «вт 16:00, 60 мин, Python, Ким Д.». Из серий генерируются уроки и считаются абонементы.
model ScheduleSeries {
  id          String       @id @default(cuid())
  teacherId   String
  teacher     Teacher      @relation(fields: [teacherId], references: [id])
  clientId    String? // индивидуальное
  client      Client?      @relation(fields: [clientId], references: [id])
  groupId     String? // групповое
  group       Group?       @relation(fields: [groupId], references: [id])
  subject     String
  program     Program
  weekday     Int // 1 = пн … 7 = вс (ISO)
  startTime   String // «16:00», в поясе школы
  durationMin Int // 45 / 60 / 90
  format      LessonFormat @default(ONLINE)
  roomId      String?
  room        Room?        @relation(fields: [roomId], references: [id])
  onlineUrl   String?
  startsOn    DateTime     @db.Date // календарная дата в поясе школы, включительно
  endsOn      DateTime?    @db.Date // включительно
  createdById String?
  createdBy   User?        @relation("SeriesCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  lessons Lesson[]
}

model Lesson {
  id           String          @id @default(cuid())
  seriesId     String?
  series       ScheduleSeries? @relation(fields: [seriesId], references: [id])
  teacherId    String
  teacher      Teacher         @relation(fields: [teacherId], references: [id])
  clientId     String?
  client       Client?         @relation(fields: [clientId], references: [id])
  groupId      String?
  group        Group?          @relation(fields: [groupId], references: [id])
  subject      String
  program      Program
  startsAt     DateTime
  durationMin  Int
  format       LessonFormat    @default(ONLINE) // сейчас все уроки онлайн
  roomId       String?
  room         Room?           @relation(fields: [roomId], references: [id])
  onlineUrl    String?
  status       LessonStatus    @default(PLANNED)
  cancelledBy  CancelledBy?
  cancelledAt  DateTime?
  cancelReason String?
  movedToId    String?         @unique
  movedTo      Lesson?         @relation("LessonMove", fields: [movedToId], references: [id])
  movedFrom    Lesson?         @relation("LessonMove")
  isTrial      Boolean         @default(false)
  topic        String?
  homework     String?
  comment      String?
  markedAt     DateTime?
  markedById   String?
  markedBy     User?           @relation("LessonMarkedBy", fields: [markedById], references: [id])
  createdById  String?
  createdBy    User?           @relation("LessonCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())

  attendances   Attendance[]
  invoiceItems  InvoiceItem[]
  accruals      TeacherAccrual[]
  payments      Payment[]
  tasks         Task[]
  trialForLead  Lead?
  ledgerEntries LedgerEntry[]
  adjustments   InvoiceAdjustment[]
  paymentLinks  PaymentLink[]
  messages      Message[]

  @@unique([seriesId, startsAt]) // повторная генерация из серии не создаёт дублей
  @@index([teacherId, startsAt])
  @@index([roomId, startsAt])
  @@index([clientId, startsAt])
}

// Посещаемость (для индивидуального урока — одна запись)
model Attendance {
  id          String           @id @default(cuid())
  lessonId    String
  lesson      Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client           @relation(fields: [clientId], references: [id])
  status      AttendanceStatus
  paymentMode PaymentMode // снимок способа оплаты на момент урока
  price       Int // стоимость урока для клиента (часы × тариф)
  isPaid      Boolean          @default(false) // для поурочной оплаты

  @@unique([lessonId, clientId])
}

// ─────────────────────────── Деньги клиентов ───────────────────────────

model MonthlyInvoice {
  id               String        @id @default(cuid())
  clientId         String
  client           Client        @relation(fields: [clientId], references: [id])
  month            DateTime      @db.Date // 1-е число месяца
  lessonsCount     Int
  hours            Decimal       @db.Decimal(6, 2)
  pricePerHour     Int // тариф абонемента на момент расчёта
  amount           Int // по абонементу
  perLessonAmount  Int // сколько вышло бы поурочно (для сообщения)
  debtIncluded     Int           @default(0)
  creditApplied    Int           @default(0) // переплата (положительный баланс), вычтенная из счёта
  adjustmentsTotal Int           @default(0) // перенос разницы прошлых месяцев: вычеты «−», доплаты «+»
  total            Int
  dueDate          DateTime      @db.Date
  status           InvoiceStatus @default(DRAFT)
  messageText      String?
  sentAt           DateTime?
  viewedAt         DateTime?
  paidAt           DateTime?
  chargedAt        DateTime? // когда счёт списан с баланса (1-го числа или при отправке после 1-го)
  createdAt        DateTime      @default(now())

  items         InvoiceItem[]
  adjustments   InvoiceAdjustment[]
  payments      Payment[]
  ledgerEntries LedgerEntry[]
  messages      Message[]
  paymentLinks  PaymentLink[]

  @@unique([clientId, month])
}

model InvoiceItem {
  id        String         @id @default(cuid())
  invoiceId String
  invoice   MonthlyInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson         @relation(fields: [lessonId], references: [id])
  hours     Decimal        @db.Decimal(5, 2)
  amount    Int

  @@unique([invoiceId, lessonId])
  @@index([lessonId])
}

// Перенос разницы: вычет за урок прошлого месяца, отменённый школой / уважительный пропуск,
// или доплата за урок, добавленный после выставления счёта. Один урок корректируется один раз.
model InvoiceAdjustment {
  id        String         @id @default(cuid())
  invoiceId String
  invoice   MonthlyInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  clientId  String
  lessonId  String
  lesson    Lesson         @relation(fields: [lessonId], references: [id])
  amount    Int // вычет «−», доплата «+»
  reason    String

  @@unique([clientId, lessonId])
  @@index([invoiceId])
}

model Payment {
  id           String          @id @default(cuid())
  clientId     String
  client       Client          @relation(fields: [clientId], references: [id])
  amount       Int // > 0
  method       PaymentMethod
  invoiceId    String? // оплата абонемента
  invoice      MonthlyInvoice? @relation(fields: [invoiceId], references: [id])
  lessonId     String? // поурочная оплата
  lesson       Lesson?         @relation(fields: [lessonId], references: [id])
  receivedById String?
  receivedBy   User?           @relation(fields: [receivedById], references: [id])
  comment      String?
  paidAt       DateTime        @default(now())
  cancelledAt  DateTime? // ошибочный платёж: сторнирован в журнале, сам платёж остаётся в истории
  cancelReason String?
  createdAt    DateTime        @default(now())

  ledgerEntries LedgerEntry[]
}

// Единый журнал движения денег клиента. Баланс = сумма amount.
model LedgerEntry {
  id           String          @id @default(cuid())
  clientId     String
  client       Client          @relation(fields: [clientId], references: [id])
  type         LedgerType
  amount       Int // + поступление / − начисление
  paymentId    String?
  payment      Payment?        @relation(fields: [paymentId], references: [id])
  lessonId     String?
  lesson       Lesson?         @relation(fields: [lessonId], references: [id])
  invoiceId    String?
  invoice      MonthlyInvoice? @relation(fields: [invoiceId], references: [id])
  comment      String?
  // Сторно: запись, которую эта запись отменяет (финансовые записи не удаляются)
  reversalOfId String?         @unique
  reversalOf   LedgerEntry?    @relation("LedgerReversal", fields: [reversalOfId], references: [id])
  reversedBy   LedgerEntry?    @relation("LedgerReversal")
  createdById  String?
  createdBy    User?           @relation(fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())

  @@index([clientId, createdAt])
  @@index([lessonId])
}

// ─────────────────────────── Зарплаты ───────────────────────────

// Начисление педагогу за конкретный урок (пересчитывается при изменении отметки)
model TeacherAccrual {
  id           String   @id @default(cuid())
  teacherId    String
  teacher      Teacher  @relation(fields: [teacherId], references: [id])
  lessonId     String   @unique
  lesson       Lesson   @relation(fields: [lessonId], references: [id])
  hours        Decimal  @db.Decimal(5, 2) // в объём для надбавки; 0 для пробного
  hourlyAmount Int      @default(0) // часы × ставка — к ней применяется надбавка
  extraAmount  Int      @default(0) // доплата за учеников группы / пробный — без надбавки
  amount       Int // hourlyAmount + extraAmount, без надбавки за объём
  basis        String // «1,5 ч × 700 ₽ + 5 × 100 ₽»
  createdAt    DateTime @default(now())
}

model Payroll {
  id           String        @id @default(cuid())
  teacherId    String
  teacher      Teacher       @relation(fields: [teacherId], references: [id])
  month        DateTime      @db.Date // 1-е число
  hours        Decimal       @db.Decimal(6, 2)
  baseAmount   Int
  bonusPercent Decimal       @db.Decimal(5, 2)
  bonusAmount  Int
  adjustments  Int           @default(0)
  total        Int
  status       PayrollStatus @default(OPEN)
  closedAt     DateTime? // при закрытии hours/baseAmount/bonus/total фиксируются
  closedById   String?
  closedBy     User?         @relation("PayrollClosedBy", fields: [closedById], references: [id])

  items   PayrollAdjustment[]
  payouts PayrollPayment[]

  @@unique([teacherId, month])
}

model PayrollAdjustment {
  id          String    @id @default(cuid())
  payrollId   String
  payroll     Payroll   @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  amount      Int // премия «+», штраф «−»
  reason      String
  kind        String    @default("MANUAL") // MANUAL — премия/штраф; RECALC — перерасчёт закрытого месяца
  sourceMonth DateTime? @db.Date // для RECALC: за какой месяц
  createdAt   DateTime  @default(now())
  createdById String?
  createdBy   User?     @relation("PayrollAdjustmentAuthor", fields: [createdById], references: [id])
}

model PayrollPayment {
  id           String    @id @default(cuid())
  payrollId    String
  payroll      Payroll   @relation(fields: [payrollId], references: [id])
  amount       Int
  paidAt       DateTime
  isAdvance    Boolean   @default(false)
  comment      String?
  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime  @default(now())
  createdById  String?
  createdBy    User?     @relation("PayrollPaymentAuthor", fields: [createdById], references: [id])
}

model Expense {
  id           String    @id @default(cuid())
  category     String // аренда, реклама, материалы…
  amount       Int
  date         DateTime  @db.Date
  comment      String?
  cancelledAt  DateTime? // ошибочная запись: не удаляется, а отменяется с причиной
  cancelReason String?
  createdAt    DateTime  @default(now())
  createdById  String?
  createdBy    User?     @relation("ExpenseAuthor", fields: [createdById], references: [id])

  @@index([date])
}

// ─────────────────────────── Задачи и лиды ───────────────────────────

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  type        String // debt, subscription, lesson, lead, transfer, other
  status      TaskStatus   @default(NEW)
  priority    TaskPriority @default(NORMAL)
  dueAt       DateTime?
  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById String?
  createdBy   User?        @relation("TaskCreator", fields: [createdById], references: [id])
  clientId    String?
  client      Client?      @relation(fields: [clientId], references: [id])
  leadId      String?
  lead        Lead?        @relation(fields: [leadId], references: [id])
  lessonId    String?
  lesson      Lesson?      @relation(fields: [lessonId], references: [id])
  isAuto      Boolean      @default(false)
  autoKey     String?      @unique // для дедупликации автозадач
  doneAt      DateTime?
  createdAt   DateTime     @default(now())

  comments TaskComment[]

  @@index([assigneeId, status])
}

model TaskComment {
  id       String   @id @default(cuid())
  taskId   String
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text     String
  authorId String?
  author   User?    @relation("TaskCommentAuthor", fields: [authorId], references: [id])
  at       DateTime @default(now())
}

model Lead {
  id                String     @id @default(cuid())
  childName         String
  grade             Int?
  parentName        String?
  phone             String
  source            LeadSource
  subject           String?
  program           Program?
  goal              String?
  preferredTime     String?
  stage             LeadStage  @default(NEW)
  lostReason        String?
  ownerId           String?
  owner             User?      @relation(fields: [ownerId], references: [id])
  trialLessonId     String?    @unique
  trialLesson       Lesson?    @relation(fields: [trialLessonId], references: [id])
  convertedClientId String?    @unique
  convertedClient   Client?    @relation(fields: [convertedClientId], references: [id])
  lastTouchAt       DateTime?
  comment           String?
  createdAt         DateTime   @default(now())

  touches LeadTouch[]
  tasks   Task[]

  @@index([stage])
}

model LeadTouch {
  id       String   @id @default(cuid())
  leadId   String
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind     String   @default("note") // call — звонок, message — сообщение, note — заметка, stage — смена этапа
  text     String
  authorId String?
  author   User?    @relation(fields: [authorId], references: [id])
  at       DateTime @default(now())

  @@index([leadId, at])
}

// ─────────────────────────── Сообщения и оплата по ссылке ───────────────────────────

// Исходящие сообщения родителям (Telegram, позже WhatsApp/SMS) — с историей доставки.
model Message {
  id          String          @id @default(cuid())
  channel     Channel         @default(TELEGRAM)
  kind        String // invoice, lesson_payment, invoice_reminder, other
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id])
  parentId    String?
  parent      Parent?         @relation(fields: [parentId], references: [id])
  invoiceId   String?
  invoice     MonthlyInvoice? @relation(fields: [invoiceId], references: [id])
  lessonId    String?
  lesson      Lesson?         @relation(fields: [lessonId], references: [id])
  text        String
  status      MessageStatus   @default(QUEUED)
  error       String?
  createdById String?
  createdAt   DateTime        @default(now())
  sentAt      DateTime?

  @@index([status, createdAt])
  @@index([clientId, createdAt])
}

// Одноразовая ссылка-приглашение t.me/<бот>?start=<code> для привязки родителя к боту.
model TelegramInvite {
  id        String    @id @default(cuid())
  parentId  String
  parent    Parent    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  code      String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
}

// Ссылка на страницу оплаты (/pay/<token>): реквизиты и QR для перевода. Для поурочников —
// одна на (урок, ученик); отметка «под угрозой», если к дедлайну не оплачено.
model PaymentLink {
  id        String          @id @default(cuid())
  token     String          @unique
  clientId  String
  client    Client          @relation(fields: [clientId], references: [id])
  invoiceId String?         @unique
  invoice   MonthlyInvoice? @relation(fields: [invoiceId], references: [id])
  lessonId  String?
  lesson    Lesson?         @relation(fields: [lessonId], references: [id])
  amount    Int
  purpose   String
  createdAt DateTime        @default(now())
  sentAt    DateTime?
  atRiskAt  DateTime? // не оплачено к дедлайну (за 24 ч до урока)

  @@unique([lessonId, clientId])
}

// Журнал фоновых задач: ключ гарантирует, что задача на период выполняется один раз.
model JobRun {
  id         String    @id @default(cuid())
  key        String    @unique // «invoices:2026-11», «charge:2026-11», «overdue:2026-11»
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  result     Json?
}

// Одноразовая ссылка для сотрудника: задать пароль и войти (почта не настроена — ссылку отправляют в мессенджере).
model UserInvite {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("UserInvites", fields: [userId], references: [id], onDelete: Cascade)
  token       String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
}

// ─────────────────────────── Настройки и аудит ───────────────────────────

// Ключ-значение: invoiceDay=25, invoiceDueDay=1, overdueDay=3, perLessonLinkHours=48,
// perLessonDeadlineHours=24, creditOnSchoolCancel=true, creditOnExcused=true, recalcOnScheduleChange=true
model Setting {
  key   String @id
  value Json
}

model AuditLog {
  id       String   @id @default(cuid())
  entity   String
  entityId String
  action   String
  diff     Json?
  userId   String?
  user     User?    @relation(fields: [userId], references: [id])
  at       DateTime @default(now())

  @@index([entity, entityId])
}
