# База данных (docker compose up -d)
DATABASE_URL="postgresql://lidd:lidd@localhost:5432/lidd_crm?schema=public"

# Auth.js: секрет для подписи JWT. Сгенерировать: npx auth secret  (или openssl rand -base64 32)
AUTH_SECRET="change-me"
# Для локальной разработки за http
AUTH_TRUST_HOST=true

# Пароль, который сид выставит пользователям owner@ / admin@ / kim@lidd.school
SEED_PASSWORD="change-me"
