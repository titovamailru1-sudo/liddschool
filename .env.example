# База данных (docker compose up -d)
DATABASE_URL="postgresql://lidd:lidd@localhost:5432/lidd_crm?schema=public"

# Auth.js: секрет для подписи JWT. Сгенерировать: npx auth secret  (или openssl rand -base64 32)
AUTH_SECRET="change-me"
# Для локальной разработки за http
AUTH_TRUST_HOST=true

# Пароль, который сид выставит пользователям owner@ / admin@ / kim@lidd.school
SEED_PASSWORD="change-me"

# Публичный адрес CRM — для ссылок на оплату в сообщениях родителям
APP_URL="http://localhost:3000"

# Telegram-бот родителей: создать у @BotFather. Без токена сообщения помечаются «не отправлено».
TELEGRAM_BOT_TOKEN=""
# Необязательно: имя бота без @ (иначе берётся через getMe)
TELEGRAM_BOT_USERNAME=""
# 1 — заглушка: сообщения пишутся в лог воркера вместо отправки (для разработки и тестов)
TELEGRAM_FAKE="0"
