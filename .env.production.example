# Продакшен: скопировать в .env на сервере и заполнить. Инструкция — docs/DEPLOY.md.

# Домен CRM (A-запись должна указывать на IP сервера). Сертификат HTTPS выпустится сам.
DOMAIN=crm.liddschool.ru
# Адрес CRM для ссылок в сообщениях родителям (тот же домен, с https://)
APP_URL=https://crm.liddschool.ru

# Пароль базы данных — длинный случайный: openssl rand -hex 24
DB_PASSWORD=
# Секрет подписи сессий: openssl rand -base64 32
AUTH_SECRET=

# Telegram-бот для родителей (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Чат владельца для оповещений об ошибках и неудачных копиях (узнать id: написать боту @userinfobot)
ALERT_TELEGRAM_CHAT_ID=

# Резервные копии: время (по Владивостоку) и сколько дней хранить на сервере
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=14
# S3-хранилище (Timeweb / Selectel / Yandex Object Storage). Пусто — копии только на сервере.
BACKUP_S3_ENDPOINT=https://s3.timeweb.cloud
BACKUP_S3_REGION=ru-1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_KEEP_DAYS=30
